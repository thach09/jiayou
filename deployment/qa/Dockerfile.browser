FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /qa
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/tests/auth-cookie-smoke.mjs tests/auth-cookie-smoke.mjs
COPY deployment/qa/api-acceptance.mjs tests/api-acceptance.mjs
COPY --chmod=0755 deployment/qa/browser-entrypoint.sh /usr/local/bin/jiayou-browser
ARG RELEASE_SHA
LABEL io.jiayou.component="qa-browser" org.opencontainers.image.revision="$RELEASE_SHA"
USER pwuser
ENTRYPOINT ["/usr/local/bin/jiayou-browser"]
