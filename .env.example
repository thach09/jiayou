# Copy outside the checkout. No production host/domain/budgets have been selected.
# Use deployment/jiayou.py --env /absolute/path/release.env <command>.
# No actual password or signing key belongs in this file; use secret files below.
JIAYOU_DOCKER_CONTEXT=
JIAYOU_RELEASE_SHA=
JIAYOU_COMPOSE_PROJECT=
JIAYOU_TARGET_ID=
JIAYOU_DATABASE_NAME=
JIAYOU_POSTGRES_OPERATOR=
JIAYOU_MIGRATION_USER=
JIAYOU_DATABASE_USER=
JIAYOU_DATABASE_VOLUME=
JIAYOU_APPLICATION_NETWORK=
# Operator-selected non-overlapping IPv4 subnet and reserved frontend address.
JIAYOU_APPLICATION_SUBNET=
JIAYOU_FRONTEND_IP=
# Exact HTTPS origin, hostname without scheme/port, approved immediate ingress peers.
JIAYOU_PUBLIC_ORIGIN=
JIAYOU_PUBLIC_HOST=
JIAYOU_INGRESS_PEERS=
# Absolute external paths. Parent directories must be private to the operator.
# Secrets: operator_password, migration_password, runtime_password, jwt_key (no newlines).
JIAYOU_SECRETS_DIR=
JIAYOU_CONFIG_DIR=
JIAYOU_STATE_DIR=
JIAYOU_BACKUP_DIR=
# All budgets must be established from host evidence with Ganbarou/OS headroom.
JIAYOU_DB_MEMORY_LIMIT=
JIAYOU_DB_CPU_LIMIT=
JIAYOU_DB_PIDS_LIMIT=
JIAYOU_BACKEND_MEMORY_LIMIT=
JIAYOU_BACKEND_CPU_LIMIT=
JIAYOU_BACKEND_PIDS_LIMIT=
JIAYOU_FRONTEND_MEMORY_LIMIT=
JIAYOU_FRONTEND_CPU_LIMIT=
JIAYOU_FRONTEND_PIDS_LIMIT=
JIAYOU_JAVA_TOOL_OPTIONS=
# Initialization acknowledgement is passed only by the explicit initialize command.
# Normal application startup is always validate-only.
